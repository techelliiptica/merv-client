# MERV Client Configuration File
# Copy this file to your project root as merv.properties and update the values

# ============================================================================
# Server Configuration
# ============================================================================
# Base URL of the MERV API server
merv.server=http://localhost:7777/api/v1

# ============================================================================
# Authentication
# ============================================================================
# Option 1: Username and Password (JWT Token Authentication)
# Username for MERV API authentication
merv.username=admin

# Password for MERV API authentication
merv.password=password

# Option 2: API Key Authentication (Alternative to username/password)
# If both are provided, API key takes precedence
# API key for MERV API authentication (get from API Keys page in UI)
# merv.api_key=merv_your_api_key_here

# ============================================================================
# Test Suite Configuration
# ============================================================================
# Test suite alias - unique identifier for test suite lookup
# If configured, you can use getTestSuiteIdFromConfig() to get the suite ID
merv.suite_alias=my-test-suite-alias

# Optional: parent project (hierarchy) UUID for new suites.
# If omitted, the API creates the suite under your Personal-workspace Default Project.
# merv.parent_hierarchy=your-hierarchy-uuid-here

# Title for a newly created test suite (required when not using merv.suite_alias / merv.append_suite)
merv.regression_suite=Regression Test Suite

# Sprint name
merv.sprint=Sprint 1

# ============================================================================
# Execution Configuration
# ============================================================================
# Whether test execution is parallel (true/false)
# Used by Cucumber handler for suite status management
merv.execution.parallel=false

# ============================================================================
# Local reports (Merv-Local)
# ============================================================================
# Root folder for timestamped run folders (html/, json/, index.html). Defaults to ./merv-reports/ when omitted.
# merv.report.folder=./merv-reports/

# Per-step screenshots from your automation driver (requires setAutomationToolObject in your hooks/base test)
# Accepts: true, on, yes, 1 (also accepts legacy key "screenshot")
# merv.screenshot=true

# Local report upload bundle for MERV UI (json/merv-report.json + screenshots → merv-report-upload.zip)
# merv.zip.export=true

# Compact interactive emailable HTML at run folder + report root (scenarios, status, failure reasons)
# Doctor / sample default is false; set true to write on every suite finish
merv.emailable.html=false
# merv.emailable.html=true

# Serve reports locally for Share / Download (Java):
#   mvn -q exec:java -Dexec.mainClass="org.teche.merv.client.utils.MervLocalReportServer"
# Or use: npx merv show-report --host 0.0.0.0
# merv.reports.server.host=127.0.0.1
# merv.reports.server.port=6174
# Use host 0.0.0.0 to share on LAN

# ============================================================================
# Merv-Logs (NDJSON + live page)
# ============================================================================
# Write NDJSON under {merv.report.folder}/log/ (default true)
# merv.logger.file=true
# merv.logger.level=INFO

# Forward this project's logs to another project's running show-report (combined Merv-Logs):
# merv.log.server=http://127.0.0.1:6174
# Project name shown on the shared Merv-Logs page (defaults to folder / package name if omitted):
# merv.log.source=my-project-name
# Env overrides: MERV_LOG_SERVER, MERV_LOG_SOURCE
# Local NDJSON is always written first; remote send is async and non-blocking.

# ============================================================================
# Example Usage
# ============================================================================
# After configuring merv.suite_alias, you can use:
# 
# MervClient client = new MervClient(
#     MervConfig.getServer(),
#     MervConfig.getUsername(),
#     MervConfig.getPassword()
# );
# 
# UUID suiteId = client.getTestSuiteIdFromConfig();
# 
# This will automatically look up the test suite ID using the alias
# configured in merv.suite_alias
# ============================================================================

